[Unit]
Description=MUCSC lab triage agent (Suricata alerts -> local AI -> Slack)
After=network-online.target suricata.service ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=labagent
Group=labagent
WorkingDirectory=/opt/lab-agent/repo/agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lab-agent/.venv/bin/python agent.py --follow --file /var/log/suricata/eve.json
Restart=always
RestartSec=5

# Hardening: the agent only reads the Suricata log, writes its bookmark,
# and talks to Ollama (localhost) and Slack. Everything else is off limits.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/lab-agent/repo/agent
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
