# Copy this file to .env and fill in your values. Never commit .env to GitHub.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PASTE/YOUR/URL
OLLAMA_MODEL=llama3.2:3b
# What the agent is guarding.
LAB_DESCRIPTION="OWASP Juice Shop, a deliberately vulnerable web store, runs at 192.168.60.10 on port 8080 behind an Nginx reverse proxy with per-IP rate limits. Status 429 means the rate limiter blocked the request, not that the attack failed or worked."

# Always-on mode (optional; these are the defaults)
WINDOW_SECONDS=60       # bundle each attacker's alerts for this long before investigating
COOLDOWN_MINUTES=10     # same attacker, same attack types within this time = folded into the digest
DIGEST_MINUTES=15       # how often low-priority findings and repeats are posted
HEARTBEAT_HOURS=24      # "still watching" message (0 = off)
IGNORE_SIDS=2200121     # noisy Suricata rules to skip, comma separated
